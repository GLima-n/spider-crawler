{
  "manifest_version": 3,
  "name": "Spider Inspector",
  "description": "Pequenas aranhas, grandes descobertas. Inspeção visual e auditoria passiva, inteiramente locais.",
  "version": "0.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": { "default_popup": "popup.html", "default_title": "Spider Inspector" },
  "background": { "service_worker": "background.js", "type": "module" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
